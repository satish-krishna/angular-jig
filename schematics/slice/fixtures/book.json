{
  "entity": "Book",
  "plural": "books",
  "labels": {
    "singular": "book",
    "plural": "books"
  },
  "kinds": [
    "entity",
    "form",
    "manage"
  ],
  "fields": [
    {
      "name": "title",
      "type": "string",
      "label": "Book Title",
      "required": true,
      "placeholder": "Book title"
    },
    {
      "name": "author",
      "type": "string",
      "label": "Author",
      "required": true,
      "placeholder": "Author name"
    },
    {
      "name": "genre",
      "type": "enum",
      "label": "Genre",
      "required": true,
      "placeholder": "Select a genre",
      "options": [
        "Fiction",
        "Mystery",
        "Science",
        "History",
        "Biography",
        "Fantasy",
        "Children"
      ]
    },
    {
      "name": "popularity",
      "type": "number",
      "label": "Popularity Index",
      "required": true,
      "min": 0,
      "max": 100,
      "default": 50
    },
    {
      "name": "availability",
      "type": "enum",
      "label": "Availability",
      "required": true,
      "inForm": false,
      "options": [
        "Available",
        "OnLoan",
        "Reserved",
        "Lost"
      ],
      "default": "Available"
    },
    {
      "name": "condition",
      "type": "enum",
      "label": "Condition",
      "required": true,
      "inForm": false,
      "options": [
        "Mint",
        "Good",
        "Worn",
        "Damaged"
      ],
      "default": "Good"
    },
    {
      "name": "timesLoaned",
      "type": "number",
      "label": "Times Loaned",
      "required": true,
      "inForm": false,
      "min": 0,
      "default": 0
    },
    {
      "name": "onTimeRate",
      "type": "number",
      "label": "On-time Return Rate",
      "required": true,
      "inForm": false,
      "min": 0,
      "max": 1,
      "default": 0
    },
    {
      "name": "holdsPlaced",
      "type": "number",
      "label": "Holds Placed",
      "required": true,
      "inForm": false,
      "min": 0,
      "default": 0
    },
    {
      "name": "blurb",
      "type": "text",
      "label": "Blurb",
      "required": false,
      "placeholder": "Short description"
    }
  ],
  "manage": {
    "icon": "lucideBookOpen",
    "createLabel": "Add book",
    "columns": [
      { "field": "title" },
      { "field": "author" },
      { "field": "genre" },
      { "field": "popularity" },
      { "field": "availability", "badge": { "variants": { "Available": "default", "Reserved": "outline", "Lost": "destructive" }, "fallback": "secondary" } },
      { "field": "condition" }
    ],
    "search": ["title", "author"],
    "filters": [{ "field": "genre", "control": "select" }],
    "sort": { "field": "popularity", "direction": "desc" },
    "summary": true
  },
  "examples": [
    {"title":"The Salt Road","author":"Imani Okafor","genre":"Fiction","popularity":92,"availability":"OnLoan","condition":"Good","timesLoaned":47,"onTimeRate":0.96,"holdsPlaced":23,"blurb":"A courier crosses a drought-stricken coast with a letter she cannot open."},
    {"title":"Nine Locks","author":"Ines Varga","genre":"Mystery","popularity":88,"availability":"Available","condition":"Mint","timesLoaned":34,"onTimeRate":0.94,"holdsPlaced":18,"blurb":"A canal keeper finds the same stranger in every lock."},
    {"title":"A Field Guide to Fog","author":"Tomas Reyes","genre":"Science","popularity":75,"availability":"Available","condition":"Worn","timesLoaned":52,"onTimeRate":0.92,"holdsPlaced":31,"blurb":"How coastal fog forms, thins, and sometimes keeps a town indoors."},
    {"title":"The Lamplighters","author":"Edith Calloway","genre":"History","popularity":85,"availability":"Reserved","condition":"Good","timesLoaned":28,"onTimeRate":0.89,"holdsPlaced":14,"blurb":"Gas-lit London told through the people who kept the lamps burning."},
    {"title":"Ember and Ash","author":"Priya Nair","genre":"Fantasy","popularity":86,"availability":"OnLoan","condition":"Worn","timesLoaned":41,"onTimeRate":0.95,"holdsPlaced":22,"blurb":"Two rival firekeepers share one dying hearth."},
    {"title":"Letters from the Ice","author":"Soren Lindqvist","genre":"Biography","popularity":72,"availability":"Available","condition":"Good","timesLoaned":38,"onTimeRate":0.91,"holdsPlaced":19,"blurb":"An Antarctic cook's correspondence, edited by his granddaughter."},
    {"title":"Moss and the Moon","author":"Hana Mori","genre":"Children","popularity":79,"availability":"Available","condition":"Damaged","timesLoaned":31,"onTimeRate":0.88,"holdsPlaced":16,"blurb":"A small hedgehog asks the moon for a bedtime story."},
    {"title":"The Quiet Archive","author":"Daniel Osei","genre":"Mystery","popularity":89,"availability":"Lost","condition":"Good","timesLoaned":24,"onTimeRate":0.96,"holdsPlaced":12,"blurb":"A records clerk notices a file that was never filed."},
    {"title":"Rivers of Salt and Iron","author":"Mira Castellano","genre":"History","popularity":81,"availability":"Available","condition":"Good","timesLoaned":45,"onTimeRate":0.9,"holdsPlaced":27,"blurb":"Trade, tolls and treaties along four river valleys."},
    {"title":"What the Bees Know","author":"Lucas Brandt","genre":"Science","popularity":77,"availability":"OnLoan","condition":"Mint","timesLoaned":22,"onTimeRate":0.87,"holdsPlaced":11,"blurb":"Field notes from a decade of hive observation."}
  ]
}
