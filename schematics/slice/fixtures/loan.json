    {"reference":"LN-0420","branch":"Northgate","status":"Requested","extended":true,"bookId":"4","memberIds":[],"borrowedOn":"2026-09-01","remarks":""},
    {"reference":"LN-0398","branch":"Eastside","status":"Overdue","extended":true,"bookId":"5","memberIds":["6"],"borrowedOn":"2026-05-22","remarks":"Two reminders sent."},
    {"reference":"LN-0301","branch":"Central","status":"Lost","extended":false,"bookId":null,"memberIds":["2"],"borrowedOn":"2025-09-10","remarks":"Book not recovered; fine waived."},
    {"reference":"LN-0425","branch":"Northgate","status":"Active","extended":false,"bookId":"7","memberIds":["3"],"borrowedOn":"2026-09-12","remarks":""},
    {"reference":"LN-0388","branch":"Central","status":"Returned","extended":true,"bookId":"9","memberIds":["1","5"],"borrowedOn":"2026-04-18","remarks":"Renewed once."}
  ]
}
