{
  "entity": "Loan",
  "plural": "loans",
  "labels": {
    "singular": "loan",
    "plural": "loans"
  },
  "kinds": [
    "entity",
    "form",
    "manage"
  ],
  "fields": [
    {
      "name": "reference",
      "type": "string",
      "label": "Reference",
      "required": true,
      "placeholder": "Loan reference"
    },
    {
      "name": "branch",
      "type": "string",
      "label": "Branch",
      "required": true,
      "placeholder": "Pickup branch"
    },
    {
      "name": "status",
      "type": "enum",
      "label": "Status",
      "required": true,
      "placeholder": "Select a status",
      "options": [
        "Requested",
        "Active",
        "Returned",
        "Overdue",
        "Lost"
      ],
      "default": "Requested"
    },
    {
      "name": "extended",
      "type": "boolean",
      "label": "Extended loan",
      "required": true
    },
    {
      "name": "bookId",
      "type": "ref",
      "label": "Borrowed Book",
      "required": false,
      "placeholder": "No book selected",
      "ref": {
        "entity": "Book",
        "plural": "books",
        "label": "title"
      }
    },
    {
      "name": "memberIds",
      "type": "ref",
      "label": "Borrowers",
      "required": false,
      "inForm": false,
      "many": true,
      "default": [],
      "ref": {
        "entity": "Member",
        "plural": "members",
        "label": "name"
      }
    },
    {
      "name": "borrowedOn",
      "type": "date",
      "label": "Borrowed On",
      "required": true,
      "placeholder": "YYYY-MM-DD"
    },
    {
      "name": "remarks",
      "type": "text",
      "label": "Remarks",
      "required": false,
      "placeholder": "Counter notes"
    }
  ],
  "manage": {
    "icon": "lucideBookMarked",
    "createLabel": "New loan",
    "columns": [
      {
        "field": "reference"
      },
      {
        "field": "branch"
      },
      {
        "field": "status",
        "badge": {
          "variants": {
            "Returned": "default",
            "Overdue": "destructive"
          },
          "fallback": "secondary"
        }
      },
      {
        "field": "extended"
      },
      {
        "field": "borrowedOn"
      }
    ],
    "search": [
      "reference",
      "branch"
    ],
    "filters": [
      {
        "control": "toggle",
        "field": "extended",
        "label": "Extended only",
        "icon": "lucideRefreshCw"
      }
    ]
  },
  "examples": [
