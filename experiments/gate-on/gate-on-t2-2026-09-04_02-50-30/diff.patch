@@ -0,0 +1,34 @@
+import { Injectable } from '@angular/core';
+
+export interface Hero {
+  id: number;
+  name: string;
+}
+
+@Injectable({
+  providedIn: 'root',
+})
+export class HeroService {
+  private heroes: Hero[] = [
+    { id: 1, name: 'Mr. Nice' },
+    { id: 2, name: 'Narco' },
+    { id: 3, name: 'Bombasto' },
+    { id: 4, name: 'Celeritas' },
+    { id: 5, name: 'Magneta' },
+    { id: 6, name: 'RubberMan' },
+    { id: 7, name: 'Dynama' },
+    { id: 8, name: 'Dr. IQ' },
+    { id: 9, name: 'Magma' },
+    { id: 10, name: 'Tornado' },
+    { id: 11, name: 'Windstorm' },
+    { id: 12, name: 'Captain Planet' },
+  ];
+
+  getHeroes(): Hero[] {
+    return this.heroes;
+  }
+
+  getHeroById(id: number): Hero | undefined {
+    return this.heroes.find((h) => h.id === id);
+  }
+}
