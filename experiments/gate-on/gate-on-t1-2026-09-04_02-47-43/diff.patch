--- /dev/null
+++ b/src/app/services/hero.service.ts
@@ -0,0 +1,47 @@
+import { Injectable } from '@angular/core';
+
+export interface Hero {
+  id: number;
+  name: string;
+}
+
+@Injectable({
+  providedIn: 'root'
+})
+export class HeroService {
+  private heroes: Hero[] = [
+    { id: 1, name: 'Mr. Nice' },
+    { id: 2, name: 'Narco' },
+    { id: 3, name: 'Bombasto' },
+    { id: 4, name: 'Celeritas' },
+    { id: 5, name: 'Magneta' },
+    { id: 6, name: 'RubberMan' },
+    { id: 7, name: 'Dynama' },
+    { id: 8, name: 'Dr IQ' },
+    { id: 9, name: 'Magma' },
+    { id: 10, name: 'Tornado' },
+    { id: 11, name: 'Dr Strange' },
+    { id: 12, name: 'Black Widow' }
+  ];
+
+  getHeroes(): Hero[] {
+    return this.heroes;
+  }
+
+  getHero(id: number): Hero | undefined {
+    return this.heroes.find(h => h.id === id);
+  }
+
+  getTopHeroes(count: number): Hero[] {
+    return this.heroes.slice(0, count);
+  }
+
+  searchHeroes(term: string): Hero[] {
+    if (!term.trim()) {
+      return [];
+    }
+    return this.heroes.filter(h =>
+      h.name.toLowerCase().includes(term.toLowerCase())
+    );
+  }
+}
