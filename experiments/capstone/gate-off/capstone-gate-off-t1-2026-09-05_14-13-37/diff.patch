+              <tbody hlmTableBody>
+                <tr *ngFor="let hero of vm.filteredHeroes()" hlmTableRow class="border-b border-border hover:bg-muted">
+                  <!-- Hero Name & Avatar -->
+                  <td hlmTableCell class="px-6 py-4">
+                    <div class="flex items-center gap-3">
+                      <hlm-avatar class="h-8 w-8">
