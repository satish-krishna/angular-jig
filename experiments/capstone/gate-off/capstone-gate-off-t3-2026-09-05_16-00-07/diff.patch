+export type PowerClass = 'Aerial' | 'Energy' | 'Psionic' | 'Tech' | 'Mutant' | 'Cosmic' | 'Enhanced';
+export type HeroStatus = 'Active' | 'Injured' | 'Reserve' | 'MIA';
+export type ClearanceTier = 'Tier1' | 'Tier2' | 'Tier3' | 'Tier4' | 'Tier5';
+
+export interface Hero {
+  id: string;
+  name: string;
+  alias: string;
+  powerClass: PowerClass;
+  powerIndex: number;
+  status: HeroStatus;
+  clearanceTier: ClearanceTier;
+  missionCount: number;
+  successRate: number;
+}
