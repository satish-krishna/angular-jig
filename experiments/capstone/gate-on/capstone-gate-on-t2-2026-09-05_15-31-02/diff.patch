+  updateHero(id: string, updates: Partial<Omit<Hero, 'id'>>): void {
+    this.heroesSignal.update((heroes) =>
+      heroes.map((h) => (h.id === id ? { ...h, ...updates } : h)),
+    );
+  }
+
+  addHero(hero: Hero): void {
+    this.heroesSignal.update((heroes) => [...heroes, hero]);
+  }
+}
