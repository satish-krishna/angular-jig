+      }
+    });
+  }
+
+  onSaveForm(): void {
+    submit(this.heroForm, async () => {
+      const heroData = this.hero();
+      if (heroData) {
+        this.heroService.updateHero(heroData.id, this.model().name);
+        this.location.back();
+      }
+    });
+  }
+
+  onCancel(): void {
+    this.location.back();
+  }
+}
+
