+  imports: [HlmButtonImports, HlmInputImports, HlmCardImports],
+  template: `
+    <div class="flex flex-col gap-6 p-6">
+      <h1 class="text-3xl font-bold">Hero Details</h1>
+
+      @if (hero(); as currentHero) {
+        <div class="flex flex-col gap-6">
