{
  "entity": "Hero",
  "plural": "heroes",
  "labels": {
    "singular": "hero",
    "plural": "heroes"
  },
  "kinds": [
    "entity",
    "form",
    "manage"
  ],
  "fields": [
    {
      "name": "name",
      "type": "string",
      "label": "Name",
      "required": true,
      "placeholder": "Hero name"
    },
    {
      "name": "alias",
      "type": "string",
      "label": "Alias",
      "required": true,
      "placeholder": "Civilian name or Unknown"
    },
    {
      "name": "powerClass",
      "type": "enum",
      "label": "Class",
      "required": true,
      "placeholder": "Select a class",
      "options": [
        "Aerial",
        "Energy",
        "Psionic",
        "Tech",
        "Mutant",
        "Cosmic",
        "Enhanced"
      ],
      "default": "Enhanced"
    },
    {
      "name": "power",
      "type": "number",
      "label": "Power index",
      "required": true,
      "help": "Power index, 0 to 100.",
      "min": 0,
      "max": 100,
      "default": 50
    },
    {
      "name": "status",
      "type": "enum",
      "label": "Status",
      "required": true,
      "placeholder": "Select a status",
      "options": [
        "Active",
        "Injured",
        "Reserve",
        "MIA"
      ],
      "default": "Active"
    },
    {
      "name": "clearance",
      "type": "enum",
      "label": "Clearance",
      "required": true,
      "inForm": false,
      "options": [
        "Tier 1",
        "Tier 2",
        "Tier 3",
        "Tier 4",
        "Tier 5"
      ],
      "default": "Tier 1"
    },
    {
      "name": "notes",
      "type": "text",
      "label": "Notes",
      "required": false,
      "placeholder": "Field notes"
    }
  ],
  "manage": {
    "icon": "lucideUsers",
    "createLabel": "Recruit",
    "createRoute": "/recruit",
    "columns": [
      {
        "field": "name"
      },
      {
        "field": "powerClass",
        "badge": {
          "variants": {},
          "fallback": "secondary"
        }
      },
      {
        "field": "power"
      },
      {
        "field": "status",
        "badge": {
          "variants": {
            "Active": "default",
            "Injured": "secondary",
            "Reserve": "outline",
            "MIA": "destructive"
          },
          "fallback": "outline"
        }
      },
      {
        "field": "clearance"
      }
    ],
    "search": [
      "name",
      "alias"
    ],
    "filters": [
      {
        "control": "select",
        "field": "powerClass"
      }
    ],
    "sort": {
      "field": "power",
      "direction": "desc"
    },
    "summary": true
  },
