+    expect(vm.filtered().length).toBe(TestBed.inject(HeroService).heroes().length);
+  });
+
+  it('filters by the search fields', () => {
+    const service = TestBed.inject(HeroService);
+    const created = service.create({
+      name: 'Test name',
+      alias: 'Test alias',
+      powerClass: 'Aerial',
+      power: 0,
+      notes: '',
+      active: false,
+    });
+    vm.searchQuery.set('Test name'.toLowerCase());
+    expect(vm.filtered().map((item) => item.id)).toContain(created.id);
+    vm.searchQuery.set('no record contains this');
+    expect(vm.filtered()).toEqual([]);
+  });
+
+  it('filters by powerClass and returns every record when the filter is cleared', () => {
+    const service = TestBed.inject(HeroService);
+    vm.powerClassFilter.set(vm.powerClassFilterOptions[1].value);
+    expect(vm.filtered().every((item) => item.powerClass === vm.powerClassFilter())).toBe(true);
+    vm.powerClassFilter.set('');
+    expect(vm.filtered().length).toBe(service.heroes().length);
+  });
+
+  it('orders the list by power, descending', () => {
+    const values = vm.filtered().map((item) => item.power);
+    expect(values).toEqual([...values].sort((a, b) => (a - b) * -1));
+  });
+
+  it('puts the larger power first', () => {
+    const service = TestBed.inject(HeroService);
+    const low = service.create({
+      name: 'Test name',
+      alias: 'Test alias',
+      powerClass: 'Aerial',
+      power: 9,
+      notes: '',
+      active: false,
+    });
+    const high = service.create({
+      name: 'Test name',
+      alias: 'Test alias',
+      powerClass: 'Aerial',
+      power: 100,
+      notes: '',
+      active: false,
+    });
+    const ids = vm.filtered().map((item) => item.id);
+    expect(ids.indexOf(high.id)).toBeLessThan(ids.indexOf(low.id));
+  });
+
+  it('ignores a save when no record is being edited', () => {
+    const service = TestBed.inject(HeroService);
+    const before = service.heroes();
+    vm.save({
+      name: 'Test name',
+      alias: 'Test alias',
+      powerClass: 'Aerial',
+      power: 0,
+      notes: '',
+      active: false,
+    });
+    expect(service.heroes()).toBe(before);
+  });
+
+  it('derives initials from the first two words of a name', () => {
+    expect(vm.initialsOf('Ms. Meridian')).toBe('MM');
+    expect(vm.initialsOf('Silverwing')).toBe('S');
+  });
+
+  it('removes a record', () => {
+    const service = TestBed.inject(HeroService);
+    const created = service.create({
+      name: 'Test name',
+      alias: 'Test alias',
+      powerClass: 'Aerial',
+      power: 0,
+      notes: '',
+      active: false,
+    });
+    vm.remove(created.id);
+    expect(service.byId(created.id)).toBeUndefined();
+  });
+
+  it('resolves the record being edited once startEdit runs', () => {
+    const service = TestBed.inject(HeroService);
+    const created = service.create({
+      name: 'Test name',
+      alias: 'Test alias',
+      powerClass: 'Aerial',
+      power: 0,
+      notes: '',
+      active: false,
+    });
+    expect(vm.editingHero()).toBeUndefined();
+    vm.startEdit(created.id);
+    expect(vm.editingHero()?.id).toBe(created.id);
+  });
+
+  it('updates rather than creates when a record is being edited', () => {
+    const service = TestBed.inject(HeroService);
+    const created = service.create({
+      name: 'Test name',
+      alias: 'Test alias',
+      powerClass: 'Aerial',
+      power: 0,
+      notes: '',
+      active: false,
+    });
+    const before = service.heroes().length;
+    vm.startEdit(created.id);
+    vm.save({
+      name: 'Changed',
+      alias: 'Test alias',
+      powerClass: 'Aerial',
+      power: 0,
+      notes: '',
+      active: false,
+    });
+    expect(service.heroes().length).toBe(before);
+    expect(service.byId(created.id)?.name).toEqual('Changed');
+    expect(vm.editing()).toBeNull();
+  });
+
+  it('falls back to a default badge variant for an unlisted powerClass', () => {
+    expect(vm.powerClassVariant('not a listed value')).toBe('secondary');
+  });
+
+  it('falls back to a default badge variant for an unlisted status', () => {
+    expect(vm.statusVariant('not a listed value')).toBe('secondary');
+  });
+
+  it('links the create action to its route', () => {
+    expect(vm.createRoute).toBe('/recruit');
+  });
+});
