diff --git a/src/app/hero-detail/hero-detail.view-model.ts b/src/app/hero-detail/hero-detail.view-model.ts
new file mode 100644
index 0000000..6f88d22
--- /dev/null
+++ b/src/app/hero-detail/hero-detail.view-model.ts
@@ -0,0 +1,80 @@
+import { Injectable, computed, inject, signal } from '@angular/core';
+import { ActivatedRoute, Router } from '@angular/router';
+import { toSignal } from '@angular/core/rxjs-interop';
+import { map } from 'rxjs';
+import { HeroService } from '../hero/hero.service';
+import type { HeroFormModel } from '../hero/hero.schema';
+import {
+  HERO_STATUS_VARIANT,
+  heroInitials,
+  isDeployable,
+  type HeroBadgeVariant,
+} from '../hero/hero-display';
+
+export const HERO_DETAIL_TABS = ['overview', 'powers', 'missions', 'edit'] as const;
+export type HeroDetailTab = (typeof HERO_DETAIL_TABS)[number];
+
+const isDetailTab = (value: string): value is HeroDetailTab =>
+  (HERO_DETAIL_TABS as readonly string[]).includes(value);
+
+// Component-scoped (no providedIn): the HeroDetail component provides it.
+@Injectable()
+export class HeroDetailViewModel {
+  private readonly heroService = inject(HeroService);
+  private readonly router = inject(Router);
+
+  // The router reuses this component when only :id changes, so the id is a stream, not a snapshot.
+  private readonly heroId = toSignal(
+    inject(ActivatedRoute).paramMap.pipe(map((params) => params.get('id') ?? '')),
+    { initialValue: '' },
+  );
+
+  readonly hero = computed(() => this.heroService.byId(this.heroId()));
+  readonly activeTab = signal<HeroDetailTab>('overview');
+
+  readonly initials = computed(() => heroInitials(this.hero()?.name ?? ''));
+
+  readonly statusVariant = computed<HeroBadgeVariant>(() => {
+    const hero = this.hero();
+    return hero ? HERO_STATUS_VARIANT[hero.status] : 'secondary';
+  });
+
+  readonly canDeploy = computed(() => {
+    const hero = this.hero();
+    return !!hero && isDeployable(hero);
+  });
+
+  // The example data carries totals, not a per-deployment log, so the result split is derived from them.
+  readonly missionResults = computed(() => {
+    const hero = this.hero();
+    const successful = hero ? Math.round((hero.missions * hero.successRate) / 100) : 0;
+    const unsuccessful = (hero?.missions ?? 0) - successful;
+    return [
+      { key: 'successful', label: 'Successful', count: successful, variant: 'success' as HeroBadgeVariant },
+      { key: 'unsuccessful', label: 'Unsuccessful', count: unsuccessful, variant: 'destructive' as HeroBadgeVariant },
+    ];
+  });
+
+  setTab(tab: string): void {
+    if (isDetailTab(tab)) this.activeTab.set(tab);
+  }
+
+  save(model: HeroFormModel): void {
+    const hero = this.hero();
+    if (!hero) return;
+    this.heroService.update(hero.id, model);
+    this.activeTab.set('overview');
+  }
+
+  deploy(): void {
+    if (!this.canDeploy()) return;
+    void this.router.navigate(['/missions']);
+  }
+
+  retire(): void {
+    const hero = this.hero();
+    if (!hero) return;
+    this.heroService.remove(hero.id);
+    void this.router.navigate(['/roster']);
+  }
+}
diff --git a/src/app/hero/hero-display.ts b/src/app/hero/hero-display.ts
new file mode 100644
index 0000000..1bb6d5a
--- /dev/null
+++ b/src/app/hero/hero-display.ts
@@ -0,0 +1,35 @@
+import type { BadgeVariants } from '@spartan-ng/helm/badge';
+import type { FormFieldMeta } from '../forms/form-field-meta';
+import { formMeta } from '../forms/zod-meta';
+import type { Hero, HeroStatus } from './hero.model';
+import { heroSchema } from './hero.schema';
+
+export type HeroBadgeVariant = NonNullable<BadgeVariants['variant']>;
+
+/** One status-to-tone mapping for every screen that shows a status, so Active reads the same everywhere. */
+export const HERO_STATUS_VARIANT: Readonly<Record<HeroStatus, HeroBadgeVariant>> = {
+  Active: 'success',
+  Injured: 'warning',
+  Reserve: 'secondary',
+  MIA: 'destructive',
+};
+
+/** Badge tone for a status string from an untyped source; anything unrecognised reads as neutral. */
+export const heroStatusVariantOf = (value: string): HeroBadgeVariant =>
+  Object.hasOwn(HERO_STATUS_VARIANT, value) ? HERO_STATUS_VARIANT[value as HeroStatus] : 'secondary';
+
+/** Power class choices, read off the schema so the filter and the form never drift apart. */
+export const POWER_CLASS_OPTIONS: NonNullable<FormFieldMeta['options']> =
+  formMeta(heroSchema)['powerClass'].options ?? [];
+
+/** Up to two initials from a hero name, for avatar fallbacks. */
+export const heroInitials = (name: string): string =>
+  name
+    .split(/\s+/)
+    .filter(Boolean)
+    .slice(0, 2)
+    .map((part) => part[0].toUpperCase())
+    .join('');
+
+/** Deployable only when cleared for duty: Active status and on the active roster. */
+export const isDeployable = (hero: Hero): boolean => hero.status === 'Active' && hero.active;
