+    vm.startEdit(created.id);
+    vm.cancel();
+    expect(vm.editing()).toBeNull();
+    expect(vm.editingHero()).toBeUndefined();
+  });
+
+  it('derives a two-letter monogram from the first two words of a name', () => {
+    expect(vm.initials('Silverwing')).toBe('S');
+    expect(vm.initials('Dr. Ion')).toBe('DI');
+    expect(vm.initials('  the   tinkerer  ')).toBe('TT');
+  });
+
+  it('removes a record', () => {
+    const service = TestBed.inject(HeroService);
+    const created = service.create({
+      name: 'Test name',
+      alias: 'Test alias',
+      powerClass: 'Aerial',
+      power: 0,
+      status: 'Active',
+      clearance: 'Tier 1',
+      notes: '',
+      active: false,
+    });
+    vm.remove(created.id);
+    expect(service.byId(created.id)).toBeUndefined();
+  });
+
+  it('resolves the record being edited once startEdit runs', () => {
+    const service = TestBed.inject(HeroService);
+    const created = service.create({
+      name: 'Test name',
+      alias: 'Test alias',
+      powerClass: 'Aerial',
+      power: 0,
+      status: 'Active',
+      clearance: 'Tier 1',
+      notes: '',
+      active: false,
+    });
+    expect(vm.editingHero()).toBeUndefined();
+    vm.startEdit(created.id);
+    expect(vm.editingHero()?.id).toBe(created.id);
