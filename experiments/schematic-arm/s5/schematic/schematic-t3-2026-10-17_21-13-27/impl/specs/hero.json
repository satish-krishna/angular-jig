{
  "entity": "Hero",
  "plural": "heroes",
  "labels": {
    "singular": "Hero",
    "plural": "Heroes"
  },
  "kinds": [
    "entity",
    "form",
    "manage"
  ],
  "fields": [
    {
      "name": "name",
      "label": "Name",
      "required": true,
      "placeholder": "e.g. Silverwing",
      "help": "The hero's public codename.",
      "type": "string"
    },
    {
      "name": "alias",
      "label": "Alias",
      "required": false,
      "placeholder": "e.g. Ada Voss",
      "help": "The civilian identity. Leave blank if unknown.",
      "type": "string"
    },
    {
      "name": "powerClass",
      "label": "Power class",
      "required": true,
      "type": "enum",
      "options": [
        "Aerial",
        "Energy",
        "Psionic",
        "Tech",
        "Mutant",
        "Cosmic",
        "Enhanced"
      ],
      "default": "Enhanced"
    },
    {
      "name": "power",
      "label": "Power index",
      "required": true,
      "min": 0,
      "max": 100,
      "help": "Scored from 0 to 100. Higher is stronger.",
      "type": "number",
      "default": 80
    },
    {
      "name": "status",
      "label": "Status",
      "required": true,
      "type": "enum",
      "options": [
        "Active",
        "Injured",
        "Reserve",
        "MIA"
      ],
      "default": "Active"
    },
    {
      "name": "clearance",
      "label": "Clearance",
      "required": true,
      "type": "enum",
      "options": [
        "Tier 1",
        "Tier 2",
        "Tier 3",
        "Tier 4",
        "Tier 5"
      ],
      "default": "Tier 1"
    },
    {
      "name": "notes",
      "label": "Notes",
      "required": false,
      "placeholder": "Field notes and deployment constraints",
      "help": "Up to 500 characters.",
      "type": "text"
    },
    {
      "name": "active",
      "label": "On active roster",
      "required": true,
      "default": true,
      "type": "boolean"
    }
  ],
