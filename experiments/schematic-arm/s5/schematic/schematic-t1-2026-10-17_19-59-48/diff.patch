+// Presentational: one hero as a card. The screen decides what a click does; this only shows.
+@Component({
+  selector: 'app-hero-card',
+  imports: [HlmAvatarImports, HlmBadgeImports, HlmCardImports, HlmH3, HlmMuted, HlmSmall, PowerMeter],
