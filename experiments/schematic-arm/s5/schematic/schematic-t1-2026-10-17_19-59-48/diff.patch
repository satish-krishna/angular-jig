+// @generated by the slice schematic from its spec. Edit in place; reshape via the spec and --force.
+import { TestBed } from '@angular/core/testing';
+import { provideRouter } from '@angular/router';
+import { HeroesViewModel } from './heroes.view-model';
+import { HeroService } from '../hero/hero.service';
+
+describe('HeroesViewModel', () => {
+  let vm: HeroesViewModel;
+
+  beforeEach(() => {
+    TestBed.configureTestingModule({ providers: [HeroesViewModel, provideRouter([])] });
+    vm = TestBed.inject(HeroesViewModel);
+  });
+
+  it('lists every record by default', () => {
+    expect(vm.filtered().length).toBe(TestBed.inject(HeroService).heroes().length);
+  });
+
+  it('filters by the search fields', () => {
+    const service = TestBed.inject(HeroService);
+    const created = service.create({
+      name: 'Test name',
+      alias: 'Test alias',
+      heroClass: 'Aerial',
+      power: 0,
+      notes: '',
+      active: false,
+    });
+    vm.searchQuery.set('Test name'.toLowerCase());
+    expect(vm.filtered().map((item) => item.id)).toContain(created.id);
+    vm.searchQuery.set('no record contains this');
+    expect(vm.filtered()).toEqual([]);
+  });
+
+  it('filters by heroClass and returns every record when the filter is cleared', () => {
+    const service = TestBed.inject(HeroService);
+    vm.heroClassFilter.set(vm.heroClassFilterOptions[1].value);
+    expect(vm.filtered().every((item) => item.heroClass === vm.heroClassFilter())).toBe(true);
+    vm.heroClassFilter.set('');
+    expect(vm.filtered().length).toBe(service.heroes().length);
+  });
+
+  it('orders the list by power, descending', () => {
+    const values = vm.filtered().map((item) => item.power);
+    expect(values).toEqual([...values].sort((a, b) => (a - b) * -1));
+  });
+
+  it('puts the larger power first', () => {
+    const service = TestBed.inject(HeroService);
+    const low = service.create({
+      name: 'Test name',
+      alias: 'Test alias',
+      heroClass: 'Aerial',
+      power: 9,
+      notes: '',
+      active: false,
+    });
+    const high = service.create({
+      name: 'Test name',
+      alias: 'Test alias',
+      heroClass: 'Aerial',
+      power: 100,
+      notes: '',
+      active: false,
+    });
+    const ids = vm.filtered().map((item) => item.id);
+    expect(ids.indexOf(high.id)).toBeLessThan(ids.indexOf(low.id));
+  });
+
+  it('creates a record through save when nothing is being edited', () => {
+    const service = TestBed.inject(HeroService);
+    const before = service.heroes().length;
+    vm.save({
+      name: 'Test name',
+      alias: 'Test alias',
+      heroClass: 'Aerial',
+      power: 0,
+      notes: '',
+      active: false,
+    });
+    expect(service.heroes().length).toBe(before + 1);
+    expect(vm.editing()).toBeNull();
+  });
+
+  it('removes a record', () => {
+    const service = TestBed.inject(HeroService);
+    const created = service.create({
+      name: 'Test name',
+      alias: 'Test alias',
+      heroClass: 'Aerial',
+      power: 0,
+      notes: '',
+      active: false,
+    });
+    vm.remove(created.id);
+    expect(service.byId(created.id)).toBeUndefined();
+  });
+
+  it('resolves the record being edited once startEdit runs', () => {
+    const service = TestBed.inject(HeroService);
+    const created = service.create({
+      name: 'Test name',
+      alias: 'Test alias',
+      heroClass: 'Aerial',
+      power: 0,
+      notes: '',
+      active: false,
+    });
+    expect(vm.editingHero()).toBeUndefined();
+    vm.startEdit(created.id);
+    expect(vm.editingHero()?.id).toBe(created.id);
+  });
+
+  it('updates rather than creates when a record is being edited', () => {
+    const service = TestBed.inject(HeroService);
+    const created = service.create({
+      name: 'Test name',
+      alias: 'Test alias',
+      heroClass: 'Aerial',
+      power: 0,
+      notes: '',
+      active: false,
+    });
+    const before = service.heroes().length;
+    vm.startEdit(created.id);
+    vm.save({
+      name: 'Changed',
+      alias: 'Test alias',
+      heroClass: 'Aerial',
+      power: 0,
+      notes: '',
+      active: false,
+    });
+    expect(service.heroes().length).toBe(before);
+    expect(service.byId(created.id)?.name).toEqual('Changed');
+    expect(vm.editing()).toBeNull();
+  });
+
+  it('falls back to a default badge variant for an unlisted heroClass', () => {
+    expect(vm.heroClassVariant('not a listed value')).toBe('secondary');
+  });
+
+  it('falls back to a default badge variant for an unlisted status', () => {
+    expect(vm.statusVariant('not a listed value')).toBe('outline');
+  });
+
+  it('links the create action to its route', () => {
+    expect(vm.createRoute).toBe('/recruit');
+  });
