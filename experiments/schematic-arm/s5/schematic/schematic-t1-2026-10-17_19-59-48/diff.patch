@@ -0,0 +1,127 @@
+// @generated by the slice schematic from its spec. Edit in place; reshape via the spec and --force.
+import { Injectable, computed, inject, linkedSignal, signal } from '@angular/core';
+import { toSignal } from '@angular/core/rxjs-interop';
+import { ActivatedRoute } from '@angular/router';
+import { map } from 'rxjs';
+import { HeroService } from '../hero/hero.service';
+import { heroSchema, type HeroFormModel } from '../hero/hero.schema';
+import { type BadgeVariant, isHeroStatus, STATUS_BADGE } from '../hero/hero-presentation';
+import { formMeta } from '../forms/zod-meta';
+
+/** Every piece of spec text the screen shows. The template binds to these and never repeats them. */
+const HEROES_TEXT = {
+  title: 'Roster',
+  plural: 'Heroes',
+  createLabel: 'Recruit',
+  createTitle: 'Create Hero',
+  createDescription: 'Add a new Hero.',
+  editTitle: 'Edit Hero',
+  editDescription: "Change this Hero's details and save.",
+  deleteTitle: 'Delete Hero?',
+  deleteDescription: 'This Hero will be permanently removed. This cannot be undone.',
+  searchLabel: 'Search Heroes',
+  searchPlaceholder: 'Search Heroes...',
+  empty: 'No Heroes match this filter.',
+  edit: 'Edit',
+  delete: 'Delete',
+  actions: 'Actions',
+  all: 'All',
+  sortedBy: 'sorted by power index',
+  filters: {
+    heroClass: 'Power class',
+  },
+  columns: {
+    name: 'Codename',
+    heroClass: 'Power class',
+    power: 'Power index',
+    status: 'Status',
+    clearance: 'Clearance tier',
+    missions: 'Missions',
+  },
+} as const;
+
+const HERO_CLASS_VARIANTS: Readonly<Record<string, BadgeVariant>> = {};
+
+// The power classes come from the schema, the single source of truth for the field's options.
+const HERO_CLASS_OPTIONS = formMeta(heroSchema)['heroClass'].options ?? [];
+
+@Injectable()
+export class HeroesViewModel {
+  private readonly heroService = inject(HeroService);
+  private readonly route = inject(ActivatedRoute);
+
+  readonly text = HEROES_TEXT;
+  readonly createRoute = '/recruit';
+  readonly heroes = this.heroService.heroes;
+
+  // The shell's search box navigates here with ?q=, so the roster starts from that term.
+  private readonly routeSearch = toSignal(
+    this.route.queryParamMap.pipe(map((params) => params.get('q') ?? '')),
+    { initialValue: '' },
+  );
+  readonly searchQuery = linkedSignal(() => this.routeSearch());
+  readonly heroClassFilter = signal('');
+
+  readonly heroClassFilterOptions: ReadonlyArray<{ value: string; label: string }> = [
+    { value: '', label: HEROES_TEXT.all },
+    ...HERO_CLASS_OPTIONS,
+  ];
+
+  readonly heroClassFilterLabel = (value: string): string =>
+    this.heroClassFilterOptions.find((o) => o.value === value)?.label ?? '';
+
+  /** The id of the Hero being edited, or null when no edit dialog is open. */
+  readonly editing = signal<string | null>(null);
+
+  readonly filtered = computed(() => {
+    const q = this.searchQuery().toLowerCase();
+    const heroClassSelected = this.heroClassFilter();
+    const rows = this.heroes()
+      .filter((item) => !heroClassSelected || item.heroClass === heroClassSelected)
+      .filter(
+        (item) => !q || item.name.toLowerCase().includes(q) || item.alias.toLowerCase().includes(q),
+      );
+    return [...rows].sort((a, b) => (a.power - b.power) * -1);
+  });
+
+  readonly editingHero = computed(() => {
+    const id = this.editing();
+    return id ? this.heroService.byId(id) : undefined;
+  });
+
+  /** Portrait fallback: the first letter of the first two words, or the first two letters of one word. */
+  readonly initials = (name: string): string => {
+    const words = name.trim().split(/\s+/);
+    const letters = words.length > 1 ? words.slice(0, 2).map((w) => w[0]) : [...name.trim().slice(0, 2)];
+    return letters.join('').toUpperCase();
+  };
+
+  readonly heroClassVariant = (value: string): BadgeVariant =>
+    HERO_CLASS_VARIANTS[value] ?? 'secondary';
+
+  readonly statusVariant = (value: string): BadgeVariant =>
+    isHeroStatus(value) ? STATUS_BADGE[value] : 'outline';
+
+  startEdit(id: string): void {
+    this.editing.set(id);
+  }
+
+  cancel(): void {
+    this.editing.set(null);
+  }
+
+  save(model: HeroFormModel): void {
+    const id = this.editing();
+    if (id) {
+      this.heroService.update(id, model);
+    } else {
+      this.heroService.create(model);
+    }
+    this.editing.set(null);
+  }
+
+  remove(id: string): void {
+    this.heroService.remove(id);
+    if (this.editing() === id) this.editing.set(null);
+  }
+}
