+                    id="hero-power"
+                    type="number"
+                    [formField]="vm.form.powerIndex"
+                  />
+                  <p hlmFieldDescription>{{ vm.meta.powerIndex.help }}</p>
+                  @for (error of vm.form.powerIndex().errors(); track error.kind) {
+                    <hlm-field-error>{{ error.message }}</hlm-field-error>
+                  }
+                </hlm-field>
+              </div>
+
+              <div class="hero-detail__form-actions">
+                <button hlmBtn variant="outline" type="button" (click)="vm.revert()">Cancel</button>
+                <button hlmBtn type="submit">Save</button>
+              </div>
+            </form>
+          </div>
+        </section>
+      </div>
+    </hlm-tabs>
+  </article>
+} @else {
+  <section class="hero-detail__missing">
+    <h1 class="hero-detail__title">Hero not found</h1>
+    <p class="hero-detail__note">No hero on the roster has the ID {{ vm.heroId() }}.</p>
+    <a hlmBtn variant="outline" routerLink="/roster">Back to roster</a>
+  </section>
+}
