+              <tr hlmTableRow>
+                <td hlmTableCell [attr.colSpan]="5" class="text-center">No heroes on the roster.</td>
+              </tr>
+            }
+          </tbody>
+        </table>
+      </div>
+    </div>
+  `,
+})
+export class Missions {
+  protected readonly vm = inject(MissionsViewModel);
+}
