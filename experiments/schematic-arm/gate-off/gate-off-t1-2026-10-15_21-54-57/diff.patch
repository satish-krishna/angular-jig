+import type { Hero } from './hero.model';
+
+/**
+ * EXAMPLE DATA. This roster is illustrative content for the Hero Ops Console,
+ * not real personnel records. It seeds the in-memory HeroService; there is no
+ * backend behind it, so edits do not survive a reload.
+ */
+export const EXAMPLE_ROSTER: readonly Hero[] = [
+  { id: 'HRO-0007', name: 'Silverwing', alias: 'Ada Voss', powerClass: 'Aerial', powerIndex: 88, status: 'Active', clearance: 4, missions: 64, successRate: 92, notes: 'Precision flyer. Excels at extraction and high-altitude recon. Pairs well with ground-anchor heroes on breach ops.' },
