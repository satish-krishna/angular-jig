+                @for (error of vm.form.clearance().errors(); track error.kind) {
+                  <hlm-field-error>{{ error.message }}</hlm-field-error>
+                }
+              </div>
+
+              <div hlmField>
+                <label hlmFieldLabel for="recruit-power-index">{{ meta.powerIndex.label }}</label>
