{
  "entity": "Hero",
  "plural": "heroes",
  "labels": {
    "singular": "Hero",
    "plural": "Heroes"
  },
  "kinds": ["entity", "form", "manage"],
  "fields": [
    {
      "name": "name",
      "label": "Codename",
      "required": true,
      "placeholder": "e.g. Silverwing",
      "type": "string"
    },
    {
      "name": "alias",
      "label": "Civilian alias",
      "required": true,
      "help": "Real name on file. Use Unknown or Classified where applicable.",
      "type": "string"
    },
    {
      "name": "powerClass",
      "label": "Power class",
      "required": true,
      "type": "enum",
      "options": ["Aerial", "Energy", "Psionic", "Tech", "Mutant", "Cosmic", "Enhanced"]
    },
    {
      "name": "power",
      "label": "Power index",
      "required": true,
      "help": "0 to 100.",
      "type": "number",
      "min": 0,
      "max": 100
    },
    {
      "name": "status",
      "label": "Status",
      "required": true,
      "type": "enum",
      "options": ["Active", "Injured", "Reserve", "MIA"]
    },
    {
      "name": "clearance",
      "label": "Clearance tier",
      "required": true,
      "type": "enum",
      "options": ["Tier 1", "Tier 2", "Tier 3", "Tier 4", "Tier 5"]
    },
    {
      "name": "joined",
      "label": "Joined",
      "required": true,
      "inForm": false,
      "default": "2026-10-17",
      "type": "date"
    },
    {
      "name": "missions",
      "label": "Missions",
      "required": true,
      "inForm": false,
      "default": 0,
      "min": 0,
      "type": "number"
    },
    {
      "name": "successRate",
      "label": "Success rate (%)",
      "required": true,
      "inForm": false,
      "default": 0,
      "min": 0,
      "max": 100,
      "help": "Percent of missions completed successfully.",
      "type": "number"
    },
    {
      "name": "notes",
      "label": "Dossier notes",
      "required": true,
      "placeholder": "Role, strengths, deployment limits",
      "type": "text"
    }
  ],
