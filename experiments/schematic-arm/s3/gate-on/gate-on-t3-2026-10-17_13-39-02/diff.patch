+          </td>
+          <td hlmTableCell class="roster-table__numeric">{{ row.hero.powerIndex }}</td>
+          <td hlmTableCell>
+            <span hlmBadge [variant]="row.statusVariant">{{ row.hero.status }}</span>
+          </td>
+          <td hlmTableCell>Tier {{ row.hero.clearance }}</td>
