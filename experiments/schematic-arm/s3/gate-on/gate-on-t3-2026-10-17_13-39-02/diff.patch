+              <ng-icon hlmIcon name="lucidePencil" />
+            </a>
+          </td>
+        </tr>
+      } @empty {
+        <tr hlmTableRow>
+          <td hlmTableCell colspan="6" class="roster-table__empty">
+            <span hlmMuted>No heroes match these filters.</span>
+          </td>
+        </tr>
+      }
+    </tbody>
+  </table>
+</div>
