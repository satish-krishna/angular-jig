+        <th hlmTableHead class="roster-table__numeric">Actions</th>
+      </tr>
+    </thead>
+    <tbody hlmTableBody>
+      @for (row of rows(); track row.hero.id) {
+        <tr hlmTableRow>
+          <td hlmTableCell>
+            <div class="roster-table__identity">
+              <hlm-avatar size="sm">
+                <span hlmAvatarFallback>{{ row.initials }}</span>
+              </hlm-avatar>
+              <div class="roster-table__names">
+                <span hlmSmall>{{ row.hero.name }}</span>
