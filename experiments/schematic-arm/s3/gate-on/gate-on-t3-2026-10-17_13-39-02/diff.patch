+  { id: 'MSN-0302', codename: 'Skyline Extraction', heroId: 'HRO-0007', status: 'Succeeded', threatTier: 3, cycle: 'Cycle 13' },
+  { id: 'MSN-0303', codename: 'Reactor Sweep', heroId: 'HRO-0012', status: 'Succeeded', threatTier: 5, cycle: 'Cycle 13' },
