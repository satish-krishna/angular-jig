+    HlmFieldImports,
+    HlmIconImports,
+    HlmInputImports,
+    HlmSelectImports,
+    HlmTextareaImports,
+    HlmTypographyImports,
+  ],
+  providers: [RecruitViewModel, provideIcons({ lucideUserPlus })],
+  templateUrl: './recruit.html',
+  styleUrl: './recruit.css',
+})
