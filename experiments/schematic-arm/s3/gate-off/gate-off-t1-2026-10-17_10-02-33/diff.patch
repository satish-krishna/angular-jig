+<div hlmTableContainer class="roster-table" role="region" aria-label="Roster table" tabindex="0">
+  <table hlmTable class="roster-table__table">
+    <caption hlmCaption class="roster-table__caption">Heroes, strongest first</caption>
+    <thead hlmTHead>
+      <tr hlmTr>
+        <th hlmTh scope="col">Hero</th>
+        <th hlmTh scope="col">Class</th>
+        <th hlmTh scope="col">Power</th>
+        <th hlmTh scope="col">Status</th>
+        <th hlmTh scope="col">Clearance</th>
+        <th hlmTh scope="col">Actions</th>
+      </tr>
+    </thead>
+    <tbody hlmTBody>
+      @for (row of rows(); track row.hero.id) {
+        <tr hlmTr>
+          <td hlmTd>
+            <div class="roster-table__identity">
+              <hlm-avatar size="sm">
+                <span hlmAvatarFallback>{{ row.initials }}</span>
+              </hlm-avatar>
+              <div class="roster-table__names">
+                <a hlmBtn variant="link" size="sm" class="roster-table__name" [routerLink]="['/detail', row.hero.id]">
+                  {{ row.hero.name }}
+                </a>
+                <span hlmMuted>{{ row.hero.id }}</span>
+              </div>
+            </div>
+          </td>
+          <td hlmTd>
+            <span hlmBadge variant="outline">{{ row.hero.powerClass }}</span>
+          </td>
+          <td hlmTd>{{ row.hero.powerIndex }}</td>
+          <td hlmTd>
+            <span hlmBadge [variant]="row.statusVariant">{{ row.hero.status }}</span>
+          </td>
+          <td hlmTd>{{ row.hero.clearance }}</td>
+          <td hlmTd>
+            <div class="roster-table__actions">
+              <a
+                hlmBtn
+                variant="ghost"
+                size="icon-sm"
+                hlmTooltip="Edit hero"
+                [routerLink]="['/detail', row.hero.id]"
+                [attr.aria-label]="'Edit ' + row.hero.name"
+              >
+                <ng-icon hlmIcon name="lucidePencil" />
+              </a>
+            </div>
+          </td>
+        </tr>
+      } @empty {
+        <tr hlmTr>
+          <td hlmTd colspan="6">No heroes match these filters.</td>
+        </tr>
+      }
+    </tbody>
+  </table>
+</div>
diff --git a/src/app/ui/roster-table.ts b/src/app/ui/roster-table.ts
new file mode 100644
index 0000000..e4ef81d
--- /dev/null
+++ b/src/app/ui/roster-table.ts
@@ -0,0 +1,46 @@
+import { Component, input } from '@angular/core';
+import { RouterLink } from '@angular/router';
+import { NgIcon, provideIcons } from '@ng-icons/core';
+import { lucidePencil } from '@ng-icons/lucide';
+import { HlmAvatarImports } from '@spartan-ng/helm/avatar';
+import { HlmBadgeImports } from '@spartan-ng/helm/badge';
+import { HlmButtonImports } from '@spartan-ng/helm/button';
+import { HlmIconImports } from '@spartan-ng/helm/icon';
+import { HlmTableImports } from '@spartan-ng/helm/table';
+import { HlmTooltipImports } from '@spartan-ng/helm/tooltip';
+import { HlmTypographyImports } from '@spartan-ng/helm/typography';
+import type { Hero } from '../domain/hero.model';
+import { STATUS_VARIANT, initialsOf, type StatusVariant } from './hero-status';
+
+export interface RosterRow {
+  readonly hero: Hero;
+  readonly initials: string;
+  readonly statusVariant: StatusVariant;
+}
+
+export function rosterRow(hero: Hero): RosterRow {
+  return { hero, initials: initialsOf(hero.name), statusVariant: STATUS_VARIANT[hero.status] };
+}
+
+// Presentational: the roster table. It takes rows as an input and injects no data service.
+// It sits in a scroll container so the table scrolls inside itself, never the page.
+@Component({
+  selector: 'app-roster-table',
+  imports: [
+    RouterLink,
+    NgIcon,
+    HlmAvatarImports,
+    HlmBadgeImports,
+    HlmButtonImports,
+    HlmIconImports,
+    HlmTableImports,
+    HlmTooltipImports,
+    HlmTypographyImports,
+  ],
+  providers: [provideIcons({ lucidePencil })],
+  templateUrl: './roster-table.html',
+  styleUrl: './roster-table.css',
+})
+export class RosterTable {
+  readonly rows = input.required<readonly RosterRow[]>();
+}
