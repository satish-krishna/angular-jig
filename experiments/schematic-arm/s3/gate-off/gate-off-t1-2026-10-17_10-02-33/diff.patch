@@ -0,0 +1,24 @@
+// The hero domain's vocabulary. Const tuples are the single source for both the
+// TypeScript unions and the zod enums in the edit form's schema.
+export const POWER_CLASSES = ['Aerial', 'Energy', 'Psionic', 'Tech', 'Mutant', 'Cosmic', 'Enhanced'] as const;
+export type PowerClass = (typeof POWER_CLASSES)[number];
+
+export const HERO_STATUSES = ['Active', 'Injured', 'Reserve', 'MIA'] as const;
+export type HeroStatus = (typeof HERO_STATUSES)[number];
+
+export const CLEARANCE_TIERS = ['Tier 1', 'Tier 2', 'Tier 3', 'Tier 4', 'Tier 5'] as const;
+export type ClearanceTier = (typeof CLEARANCE_TIERS)[number];
+
+export interface Hero {
+  readonly id: string;
+  readonly name: string;
+  readonly alias: string;
+  readonly powerClass: PowerClass;
+  // 0-100.
+  readonly powerIndex: number;
+  readonly status: HeroStatus;
+  readonly clearance: ClearanceTier;
+  readonly missionCount: number;
+  // Percentage, 0-100.
+  readonly successRate: number;
+}
diff --git a/src/app/domain/hero.schema.ts b/src/app/domain/hero.schema.ts
new file mode 100644
index 0000000..d1eccc2
--- /dev/null
+++ b/src/app/domain/hero.schema.ts
@@ -0,0 +1,24 @@
+import { z } from 'zod';
+import { CLEARANCE_TIERS, POWER_CLASSES } from './hero.model';
+
+// The hero form's shape, rules, and field labels. Shared by the edit form on the detail screen and the
+// recruit form. Labels ride on the schema via .meta().
+export const heroSchema = z.object({
+  name: z.string().trim().min(1).meta({ label: 'Name', control: 'text', order: 1 }),
+  alias: z.string().trim().min(1).meta({ label: 'Alias', control: 'text', order: 2 }),
+  powerClass: z.enum(POWER_CLASSES).meta({
+    label: 'Power class',
+    control: 'select',
+    order: 3,
+    options: POWER_CLASSES.map((value) => ({ value, label: value })),
+  }),
+  powerIndex: z.number().int().min(0).max(100).meta({ label: 'Power index', control: 'number', order: 4 }),
+  clearance: z.enum(CLEARANCE_TIERS).meta({
+    label: 'Clearance tier',
+    control: 'select',
+    order: 5,
+    options: CLEARANCE_TIERS.map((value) => ({ value, label: value })),
+  }),
+});
+
+export type HeroModel = z.infer<typeof heroSchema>;
