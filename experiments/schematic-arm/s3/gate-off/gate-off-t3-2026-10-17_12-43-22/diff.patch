+<header class="topbar">
+  <button hlmSidebarTrigger></button>
+
+  <nav aria-label="Breadcrumb" class="topbar__crumbs">
+    <ol class="topbar__crumb-list">
+      @for (crumb of crumbs(); track $index; let last = $last) {
+        <li class="topbar__crumb" hlmSmall>
+          @if (crumb.link && !last) {
+            <a [routerLink]="crumb.link">{{ crumb.label }}</a>
+          } @else {
+            <span aria-current="page">{{ crumb.label }}</span>
+          }
+          @if (!last) {
+            <ng-icon hlmIcon name="lucideChevronRight" tone="muted" />
+          }
+        </li>
+      }
+    </ol>
+  </nav>
+
+  <form
+    class="topbar__search"
+    role="search"
+    (submit)="$event.preventDefault(); searched.emit(query.value)"
