+
+// Threats: the heroes who are out of action, and the live missions ranked by threat tier.
+@Component({
+  selector: 'app-threats',
+  imports: [HlmBadgeImports, HlmTableImports, HlmTypographyImports, HeroCard],
+  providers: [ThreatsViewModel],
