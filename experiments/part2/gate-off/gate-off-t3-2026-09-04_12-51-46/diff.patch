+++ b/src/app/dashboard/dashboard.css
@@ -0,0 +1,95 @@
+.dashboard-container {
+  display: grid;
+  grid-template-rows: auto auto auto;
+  gap: var(--space-8, 2rem);
+  padding: var(--space-8, 2rem);
+  max-width: 1200px;
+  margin: 0 auto;
+}
+
+h1 {
+  font-size: var(--text-3xl, 1.875rem);
+  font-weight: 700;
+}
+
+h2 {
+  font-size: var(--text-xl, 1.25rem);
+  font-weight: 600;
+  margin-bottom: var(--space-4, 1rem);
+}
+
+.search-section {
+  display: grid;
+  grid-template-rows: auto auto;
+  gap: var(--space-4, 1rem);
+}
+
+.search-results {
+  margin-top: var(--space-2, 0.5rem);
+}
+
+.search-results ul {
+  list-style: none;
+  padding: 0;
+  display: grid;
+  grid-template-rows: auto;
+  gap: var(--space-2, 0.5rem);
+}
+
+.search-results li {
+  display: block;
+}
+
+.search-results a {
+  color: var(--text-primary);
+  text-decoration: none;
+  padding: var(--space-2, 0.5rem) var(--space-3, 0.75rem);
+  display: block;
+  border-radius: var(--radius, 0.375rem);
+  transition: background-color 0.2s;
+}
+
+.search-results a:hover {
+  background-color: var(--primary);
+  color: var(--primary-foreground);
+}
+
+.top-heroes-section {
+  display: grid;
+  grid-template-rows: auto auto;
+  gap: var(--space-4, 1rem);
+}
+
+.heroes-grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
+  gap: var(--space-4, 1rem);
+}
+
+.hero-card {
+  border: 1px solid var(--border);
+  border-radius: var(--radius, 0.375rem);
+  padding: var(--space-4, 1rem);
+  background-color: var(--card);
+  transition: box-shadow 0.2s;
+}
+
+.hero-card:hover {
+  box-shadow: var(--shadow-md);
+}
+
+.hero-card h3 {
+  margin: 0;
+  font-size: var(--text-lg, 1.125rem);
+}
+
+.hero-card a {
+  color: var(--text-primary);
+  text-decoration: none;
+  display: inline-block;
+  transition: color 0.2s;
+}
+
+.hero-card a:hover {
+  color: var(--primary);
+}
diff --git a/src/app/dashboard/dashboard.html b/src/app/dashboard/dashboard.html
new file mode 100644
index 0000000..720f7f5
--- /dev/null
+++ b/src/app/dashboard/dashboard.html
@@ -0,0 +1,40 @@
+<div class="dashboard-container">
+  <h1>Dashboard</h1>
+
+  <section class="search-section">
+    <h2>Hero Search</h2>
+    <input
+      hlmInput
+      type="text"
+      placeholder="Search heroes..."
+      [value]="searchTerm()"
+      (input)="onSearchInput($event)"
+      class="w-full"
+    />
+
+    @if (searchResults().length > 0) {
+      <div class="search-results">
+        <ul>
+          @for (hero of searchResults(); track hero.id) {
+            <li>
+              <a [routerLink]="['/detail', hero.id]">{{ hero.name }}</a>
+            </li>
+          }
+        </ul>
+      </div>
+    }
+  </section>
+
+  <section class="top-heroes-section">
+    <h2>Top Heroes</h2>
+    <div class="heroes-grid">
+      @for (hero of topHeroes(); track hero.id) {
+        <div class="hero-card">
+          <h3>
+            <a [routerLink]="['/detail', hero.id]">{{ hero.name }}</a>
+          </h3>
+        </div>
+      }
+    </div>
+  </section>
+</div>
