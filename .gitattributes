# rule-docs.mjs's agentGuidanceFor() reads harness/rules/*.md at hook runtime
# and matches a regex anchored on a literal LF. core.autocrlf and the absence
# of any prior .gitattributes mean a plain checkout on this repo can hand that
# code CRLF content, which silently blanks every worked example the hooks
# splice into their corrective stderr (see harness/gate/rule-docs-hook.test.mjs
# for the CRLF round-trip test that guards this in code too). Pin exactly the
# files this depends on to LF - not the whole tree, which would renormalize
# unrelated history and bury this branch's diff.
harness/rules/*.md text eol=lf
.claude/hooks/*.mjs text eol=lf

# The schematic's golden exemplars, fixtures and generated JSON schema are compared byte for
# byte. Pin them to LF so core.autocrlf cannot turn a checkout into a false diff.
schematics/slice/golden/** text eol=lf
schematics/slice/fixtures/** text eol=lf
schematics/slice/spec.schema.json text eol=lf

# Node scripts start with a #! line, and vitest fails to load a module whose #! line ends in CRLF
# ("Invalid or unexpected token"), which core.autocrlf produces on Windows. Pin every script to LF.
*.mjs text eol=lf
*.cjs text eol=lf
